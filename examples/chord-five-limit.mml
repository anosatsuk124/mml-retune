/* !JSON: "FiveLimit_C"
{
  "baseHz": 440,
  "notes": {
    "c": "264*1 - 440",
    "cs": "264*(25/24) - 440",
    "db": "264*(16/15) - 440",
    "d": "264*(9/8) - 440",
    "ds": "264*(75/64) - 440",
    "eb": "264*(6/5) - 440",
    "e": "264*(5/4) - 440",
    "f": "264*(4/3) - 440",
    "fs": "264*(45/32) - 440",
    "g": "264*(3/2) - 440",
    "gs": "264*(25/16) - 440",
    "ab": "264*(8/5) - 440",
    "a": "264*(5/3) - 440",
    "as": "264*(125/72) - 440",
    "bb": "264*(16/9) - 440",
    "b": "264*(15/8) - 440"
  },
  "plusHz": "0",
  "minusHz": 0,
  "bendRangeSemitones": 2
}
*/

STR SET_CH = { STR CUR_CH=#?1 CH(#?1) }

STR SUB1 = { CH(2) SUB{#?1} CH(CUR_CH) }
STR SUB2 = { CH(3) SUB{#?1} CH(CUR_CH) }
STR SUB3 = { CH(4) SUB{#?1} CH(CUR_CH) }

TUNE("FiveLimit_C"){
  TR(1) SET_CH(1) o5 l1
  SUB1{c} SUB2{e} {g}
  SUB1{f} SUB2{a} {>c<}
  SUB1{g} SUB2{b} {>d<}
  SUB1{c} SUB2{e} {g}
}

